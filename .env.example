# Copy to .env for local development. Use the Supabase Session Pooler connection string in production.
DATABASE_URL=postgresql://postgres.your-project:your-password@aws-0-region.pooler.supabase.com:5432/postgres
DB_POOL_SIZE=5
# Set these privately; production startup provisions the admin if it does not already exist.
ADMIN_NAME=TalentX Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-unique-password-of-at-least-14-characters
# Create a Brevo API key and verify the sender email in Brevo.
BREVO_API_KEY=replace-with-a-brevo-api-key
BREVO_SENDER_EMAIL=your-verified-sender@example.com
# Generate a separate random secret (at least 32 characters) for hashing OTP codes.
EMAIL_OTP_SECRET=replace-with-a-random-secret-of-at-least-32-characters
USER_CAPACITY=50
# Optional: defaults to data/Cleanedanalytics.csv
# CAREER_DATASET_PATH=C:\path\to\Cleanedanalytics.csv
